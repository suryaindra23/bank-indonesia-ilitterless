{
  "name": "cobi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.js",
    "role:grant": "node --env-file-if-exists=.env scripts/grant-roles.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-supabase.js",
    "test:postgres": "TEST_POSTGRES=1 node --test tests/backend.test.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-supabase.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.56.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  }
}
