# Local development. Set to the public HTTPS origin when deployed.
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Optional: YYYY-MM-DD. Otherwise first server initialization sets the pilot start.
# PILOT_START=2026-11-25
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your-account@gmail.com
MAIL_FROM_NAME="COBI"
CURATION_EMAIL=ilitterless@gmail.com

# Supabase: backend only. Transaction pooler URI (port 6543).
# Leave DATABASE_URL and SUPABASE_URL blank only for local SQLite development.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bibubebo-private
# Vercel: APP_ORIGIN=https://your-domain.example, NODE_ENV=production, TRUST_PROXY=1
